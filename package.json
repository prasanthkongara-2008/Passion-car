{
  "name": "passion-car-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@aws-sdk/lib-dynamodb": "^3.1148.0",
    "@clerk/express": "^2.1.77",
    "@clerk/react": "^6.17.7",
    "@clerk/shared": "^4.39.1",
    "@clerk/themes": "^2.4.57",
    "@tanstack/react-query": "^5.104.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "framer-motion": "^14.0.0",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.52.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
